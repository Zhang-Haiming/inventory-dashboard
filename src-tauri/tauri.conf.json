{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "库存看板",
  "version": "0.1.0",
  "identifier": "com.internal.inventory-dashboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5175",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "库存看板",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMjFBNzAzODQzQjZENEYKUldSUGJUdUVBNmNoNjFhUEdjaitLYTFkUXVaYTVmYXM0WlozZWVBcVJiOEsrcUs4QlRCbmFGL1AK",
      "endpoints": [
        "https://github.com/Zhang-Haiming/inventory-dashboard/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
