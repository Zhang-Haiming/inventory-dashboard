{
  "name": "inventory-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "dev": "cargo tauri dev",
    "build": "cargo tauri build",
    "build:backend": "cd backend && go build -o ../src-tauri/binaries/backend-$(go env GOOS)-$(go env GOARCH) ."
  },
  "build": {
    "appId": "com.internal.inventory-dashboard",
    "productName": "库存看板",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "app/out"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "notarize": false
    },
    "dmg": {
      "title": "库存看板"
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  }
}
